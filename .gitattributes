# Git LFS tracking for large model files
# Note: Git LFS not currently installed - these patterns are ready for when it's available

# Machine Learning Models (production)
detection/ml-detector/models/production/*.pkl filter=lfs diff=lfs merge=lfs -text
detection/ml-detector/models/production/*.h5 filter=lfs diff=lfs merge=lfs -text
detection/ml-detector/models/production/*.joblib filter=lfs diff=lfs merge=lfs -text

# Baseline models
detection/ml-detector/models/baselines/*.pkl filter=lfs diff=lfs merge=lfs -text
detection/ml-detector/models/baselines/*.h5 filter=lfs diff=lfs merge=lfs -text

# Large data files (if ever committed)
*.pcap filter=lfs diff=lfs merge=lfs -text
*.pcapng filter=lfs diff=lfs merge=lfs -text
