#!/bin/bash
# Nephio-to-Kubernetes Translator
# Converts Nephio intent-based configurations to actual Kubernetes native resources
# This provides Nephio-like functionality without requiring full Nephio infrastructure

set -e

# Configuration
TARGET_NAMESPACE="${TARGET_NAMESPACE:-sock-shop}"
PROTECTION_LEVEL="${PROTECTION_LEVEL:-high}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

echo -e "${MAGENTA}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${MAGENTA}║          Nephio-Style DDoS Protection Deployment             ║${NC}"
echo -e "${MAGENTA}║      (Translates Nephio Intents to K8s Native Resources)     ║${NC}"
echo -e "${MAGENTA}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo ""

echo -e "${CYAN}Configuration:${NC}"
echo -e "  Target Namespace: ${YELLOW}$TARGET_NAMESPACE${NC}"
echo -e "  Protection Level: ${YELLOW}$PROTECTION_LEVEL${NC}"
echo ""

# Check prerequisites
echo -e "${YELLOW}[1/7] Checking prerequisites...${NC}"
if ! command -v kubectl &> /dev/null; then
    echo -e "${RED}✗ kubectl not found${NC}"
    exit 1
fi

if ! kubectl cluster-info &> /dev/null; then
    echo -e "${RED}✗ Cannot connect to Kubernetes cluster${NC}"
    exit 1
fi

echo -e "${GREEN}✓ Prerequisites check passed${NC}"
echo ""

# Ensure namespace exists
echo -e "${YELLOW}[2/7] Setting up namespace...${NC}"
if ! kubectl get namespace "$TARGET_NAMESPACE" &> /dev/null; then
    kubectl create namespace "$TARGET_NAMESPACE"
    echo -e "${GREEN}✓ Created namespace: $TARGET_NAMESPACE${NC}"
else
    echo -e "${GREEN}✓ Namespace exists: $TARGET_NAMESPACE${NC}"
fi

# Label namespace with Nephio-style annotations
kubectl label namespace "$TARGET_NAMESPACE" \
    nephio.org/managed=true \
    nephio.org/protection-level="$PROTECTION_LEVEL" \
    nephio.org/deployment-mode=translated \
    --overwrite &> /dev/null

echo ""

# Deploy Nephio-inspired CRDs (optional, for compatibility)
echo -e "${YELLOW}[3/7] Deploying Nephio-compatible CRDs...${NC}"
if [ -f "$SCRIPT_DIR/../workload-apis/ddos-protection-crds.yaml" ]; then
    kubectl apply -f "$SCRIPT_DIR/../workload-apis/ddos-protection-crds.yaml" &> /dev/null || true
    echo -e "${GREEN}✓ CRDs deployed${NC}"
else
    echo -e "${YELLOW}⚠ CRDs not found, skipping (not critical)${NC}"
fi
echo ""

# Deploy Nephio-Style Autoscaling (translated to HPAs)
echo -e "${YELLOW}[4/7] Deploying Nephio-style autoscaling (as HPAs)...${NC}"
cat <<EOF | kubectl apply -f - &> /dev/null
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: front-end-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    app: front-end
    nephio.org/managed: "true"
    nephio.org/intent: "AutoScaling"
    nephio.org/protection-level: "$PROTECTION_LEVEL"
  annotations:
    nephio.org/capacity-request: "5000 rps"
    nephio.org/slo-availability: "99.9"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: front-end
  minReplicas: 2
  maxReplicas: 20
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 30
      policies:
      - type: Percent
        value: 100
        periodSeconds: 15
      - type: Pods
        value: 4
        periodSeconds: 15
      selectPolicy: Max
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
      - type: Percent
        value: 50
        periodSeconds: 60
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: catalogue-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    app: catalogue
    nephio.org/managed: "true"
    nephio.org/intent: "AutoScaling"
    nephio.org/service-class: "decoy"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: catalogue
  minReplicas: 1
  maxReplicas: 30
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 60
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: cart-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: carts
  minReplicas: 1
  maxReplicas: 25
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: orders-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "critical"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: orders
  minReplicas: 2
  maxReplicas: 10
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 75
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: payment-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "critical"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: payment
  minReplicas: 2
  maxReplicas: 10
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 75
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: user-hpa-nephio
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: user
  minReplicas: 1
  maxReplicas: 20
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
EOF

echo -e "${GREEN}✓ Deployed 6 Nephio-style HPAs${NC}"
echo ""

# Deploy Nephio-Style Network Policies
echo -e "${YELLOW}[5/7] Deploying Nephio-style network policies...${NC}"
cat <<EOF | kubectl apply -f - &> /dev/null
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nephio-default-deny-ingress
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/intent: "NetworkPolicy"
spec:
  podSelector: {}
  policyTypes:
  - Ingress
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nephio-allow-dns
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
spec:
  podSelector: {}
  policyTypes:
  - Egress
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          name: kube-system
    ports:
    - protocol: UDP
      port: 53
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nephio-frontend-ingress
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "critical"
spec:
  podSelector:
    matchLabels:
      name: front-end
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector: {}
    ports:
    - protocol: TCP
      port: 8079
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: nephio-catalogue-isolation
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "decoy"
    nephio.org/intent: "anti-crossfire"
  annotations:
    nephio.org/description: "Isolate decoy service from critical services"
spec:
  podSelector:
    matchLabels:
      name: catalogue
  policyTypes:
  - Ingress
  - Egress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          name: front-end
    ports:
    - protocol: TCP
      port: 80
  egress:
  - to:
    - podSelector:
        matchLabels:
          name: catalogue-db
    ports:
    - protocol: TCP
      port: 3306
  - to:
    - namespaceSelector:
        matchLabels:
          name: kube-system
    ports:
    - protocol: UDP
      port: 53
EOF

echo -e "${GREEN}✓ Deployed 4 Nephio-style NetworkPolicies${NC}"
echo ""

# Deploy Nephio-Style Resource Quotas
echo -e "${YELLOW}[6/7] Deploying Nephio-style resource quotas...${NC}"
cat <<EOF | kubectl apply -f - &> /dev/null
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: nephio-sock-shop-quota
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/intent: "ResourceQuota"
  annotations:
    nephio.org/capacity-intent: "namespace-wide protection"
spec:
  hard:
    requests.cpu: "20"
    requests.memory: 32Gi
    limits.cpu: "40"
    limits.memory: 64Gi
    pods: "100"
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: nephio-critical-services-quota
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "critical"
spec:
  hard:
    requests.cpu: "12"
    requests.memory: 20Gi
    pods: "50"
  scopeSelector:
    matchExpressions:
    - operator: In
      scopeName: PriorityClass
      values:
      - critical-priority
---
apiVersion: v1
kind: ResourceQuota
metadata:
  name: nephio-decoy-services-quota
  namespace: $TARGET_NAMESPACE
  labels:
    nephio.org/managed: "true"
    nephio.org/service-class: "decoy"
  annotations:
    nephio.org/intent: "limit decoy resource consumption"
spec:
  hard:
    requests.cpu: "4"
    requests.memory: 8Gi
    pods: "20"
  scopeSelector:
    matchExpressions:
    - operator: In
      scopeName: PriorityClass
      values:
      - decoy-priority
EOF

echo -e "${GREEN}✓ Deployed 3 Nephio-style ResourceQuotas${NC}"
echo ""

# Deploy PriorityClasses (Nephio-style service classification)
echo -e "${YELLOW}[7/7] Deploying Nephio-style priority classes...${NC}"
cat <<EOF | kubectl apply -f - &> /dev/null
---
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: critical-priority
  labels:
    nephio.org/managed: "true"
value: 1000000
globalDefault: false
description: "Critical services (orders, payment) get highest priority"
---
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: normal-priority
  labels:
    nephio.org/managed: "true"
value: 100000
globalDefault: true
description: "Normal priority for standard workloads"
---
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: decoy-priority
  labels:
    nephio.org/managed: "true"
value: 10000
globalDefault: false
description: "Lowest priority for decoy services"
EOF

echo -e "${GREEN}✓ Deployed 3 PriorityClasses${NC}"
echo ""

# Summary
echo -e "${MAGENTA}╔═══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${MAGENTA}║                    Deployment Complete                        ║${NC}"
echo -e "${MAGENTA}╚═══════════════════════════════════════════════════════════════╝${NC}"
echo ""

echo -e "${CYAN}Deployed Nephio-Style Resources:${NC}"
echo -e "  ${GREEN}✓${NC} 6 HorizontalPodAutoscalers (with Nephio labels/annotations)"
echo -e "  ${GREEN}✓${NC} 4 NetworkPolicies (with anti-crossfire intents)"
echo -e "  ${GREEN}✓${NC} 3 ResourceQuotas (with service classification)"
echo -e "  ${GREEN}✓${NC} 3 PriorityClasses (critical/normal/decoy)"
echo ""

echo -e "${CYAN}Nephio Intent Translation:${NC}"
echo -e "  ${BLUE}→${NC} Nephio ${MAGENTA}AutoScaling${NC} intent → K8s ${YELLOW}HorizontalPodAutoscaler${NC}"
echo -e "  ${BLUE}→${NC} Nephio ${MAGENTA}NetworkPolicy${NC} intent → K8s ${YELLOW}NetworkPolicy${NC}"
echo -e "  ${BLUE}→${NC} Nephio ${MAGENTA}ResourceQuota${NC} intent → K8s ${YELLOW}ResourceQuota${NC}"
echo -e "  ${BLUE}→${NC} Nephio ${MAGENTA}ServiceClass${NC} → K8s ${YELLOW}PriorityClass${NC} + labels"
echo ""

echo -e "${CYAN}Key Nephio-Style Features:${NC}"
echo -e "  ${MAGENTA}1.${NC} Intent-based labels (nephio.org/intent=AutoScaling)"
echo -e "  ${MAGENTA}2.${NC} Capacity annotations (nephio.org/capacity-request)"
echo -e "  ${MAGENTA}3.${NC} Service classification (critical/normal/decoy)"
echo -e "  ${MAGENTA}4.${NC} SLO annotations (nephio.org/slo-availability)"
echo -e "  ${MAGENTA}5.${NC} Anti-crossfire network isolation"
echo ""

echo -e "${CYAN}Verification:${NC}"
kubectl get hpa -n "$TARGET_NAMESPACE" -l nephio.org/managed=true 2>/dev/null | grep -v "NAME" | wc -l | xargs -I {} echo -e "  HPAs deployed: ${GREEN}{}${NC}"
kubectl get networkpolicies -n "$TARGET_NAMESPACE" -l nephio.org/managed=true 2>/dev/null | grep -v "NAME" | wc -l | xargs -I {} echo -e "  NetworkPolicies: ${GREEN}{}${NC}"
kubectl get resourcequota -n "$TARGET_NAMESPACE" -l nephio.org/managed=true 2>/dev/null | grep -v "NAME" | wc -l | xargs -I {} echo -e "  ResourceQuotas: ${GREEN}{}${NC}"
kubectl get priorityclasses -l nephio.org/managed=true 2>/dev/null | grep -v "NAME" | wc -l | xargs -I {} echo -e "  PriorityClasses: ${GREEN}{}${NC}"
echo ""

echo -e "${YELLOW}Next Steps:${NC}"
echo -e "  1. Run crossfire attack test: ${CYAN}cd ../../attack-simulations && ./test-both-crossfire-attacks.sh${NC}"
echo -e "  2. Verify HPAs scaling: ${CYAN}kubectl get hpa -n $TARGET_NAMESPACE -w${NC}"
echo -e "  3. Check network policies: ${CYAN}kubectl get networkpolicies -n $TARGET_NAMESPACE${NC}"
echo -e "  4. View resource usage: ${CYAN}kubectl top pods -n $TARGET_NAMESPACE${NC}"
echo ""

echo -e "${GREEN}✓ Nephio-style deployment complete!${NC}"
