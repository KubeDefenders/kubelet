#!/bin/bash
# Runtime Environment Configuration
# Source this file before running any component: source config/runtime.env

# Auto-detect Kubernetes cluster IP
export CLUSTER_IP=${CLUSTER_IP:-$(minikube ip 2>/dev/null || echo "localhost")}

# Target application endpoints
export TARGET_URL="http://${CLUSTER_IP}:30001"
export PROMETHEUS_URL="http://${CLUSTER_IP}:30090"
export GRAFANA_URL="http://${CLUSTER_IP}:30091"

# Component paths (absolute)
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TARGET_PATH="${PROJECT_ROOT}/target"
export ATTACKS_PATH="${PROJECT_ROOT}/attacks"
export DETECTION_PATH="${PROJECT_ROOT}/detection"
export MITIGATION_PATH="${PROJECT_ROOT}/mitigation"

# Kubernetes configuration
export TARGET_NAMESPACE="sock-shop"
export MONITORING_NAMESPACE="monitoring"

# Python configuration
export PYTHONPATH="${PROJECT_ROOT}/src:${PYTHONPATH}"

# Print configuration (optional)
if [ "${VERBOSE:-0}" = "1" ]; then
  echo "Runtime Configuration Loaded:"
  echo "  CLUSTER_IP: $CLUSTER_IP"
  echo "  TARGET_URL: $TARGET_URL"
  echo "  PROJECT_ROOT: $PROJECT_ROOT"
fi
