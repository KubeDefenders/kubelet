#!/bin/bash

# Orchestrate Complete Attack Simulation
# This script runs a complete crossfire attack simulation with monitoring

set -e

echo "======================================"
echo "Crossfire Attack Simulation Orchestrator"
echo "======================================"
echo ""

# Configuration
ATTACK_TYPE=${1:-"app"}  # app or network
DURATION=${2:-60}
WORKERS=${3:-10}
RATE=${4:-10}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check prerequisites
echo "[1/6] Checking prerequisites..."

if ! command -v kubectl &> /dev/null; then
    echo -e "${RED}Error: kubectl not found${NC}"
    exit 1
fi

if ! kubectl cluster-info &> /dev/null; then
    echo -e "${RED}Error: Kubernetes cluster not running${NC}"
    exit 1
fi

if ! kubectl get namespace sock-shop &> /dev/null; then
    echo -e "${RED}Error: sock-shop namespace not found${NC}"
    echo "Deploy Sock Shop first: ./scripts/deploy-sock-shop.sh"
    exit 1
fi

echo -e "${GREEN}✓ Prerequisites met${NC}"

# Get application URL
echo ""
echo "[2/6] Getting application URL..."

# Try to get ingress
INGRESS_HOST=$(minikube ip 2>/dev/null || echo "localhost")
INGRESS_PORT=$(kubectl -n istio-system get service istio-ingressgateway -o jsonpath='{.spec.ports[?(@.name=="http2")].nodePort}' 2>/dev/null || echo "8080")
APP_URL="http://${INGRESS_HOST}:${INGRESS_PORT}"

echo "Application URL: $APP_URL"

# Verify app is reachable
if curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 "$APP_URL" | grep -q "200\|301\|302"; then
    echo -e "${GREEN}✓ Application is reachable${NC}"
else
    echo -e "${YELLOW}⚠ Application may not be reachable at $APP_URL${NC}"
    echo "You may need to run: kubectl port-forward -n sock-shop svc/front-end 8080:80"
fi

# Start monitoring
echo ""
echo "[3/6] Starting monitoring tools..."
echo "Opening monitoring dashboards in background..."

# Start port forwards in background
kubectl port-forward -n istio-system svc/kiali 20001:20001 > /dev/null 2>&1 &
KIALI_PID=$!
sleep 2

kubectl port-forward -n istio-system svc/grafana 3000:3000 > /dev/null 2>&1 &
GRAFANA_PID=$!
sleep 2

kubectl port-forward -n istio-system svc/prometheus 9090:9090 > /dev/null 2>&1 &
PROMETHEUS_PID=$!
sleep 2

echo -e "${GREEN}✓ Monitoring tools available:${NC}"
echo "  Kiali:      http://localhost:20001"
echo "  Grafana:    http://localhost:3000"
echo "  Prometheus: http://localhost:9090"

# Baseline metrics
echo ""
echo "[4/6] Collecting baseline metrics (30 seconds)..."
echo "Please observe normal traffic in monitoring dashboards..."
sleep 30

# Run attack
echo ""
echo "[5/6] Launching attack..."
echo ""
echo -e "${RED}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║           ATTACK SIMULATION STARTING                      ║${NC}"
echo -e "${RED}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""
echo "Attack Type: $ATTACK_TYPE"
echo "Duration: ${DURATION}s"
echo "Workers/Threads: $WORKERS"
echo "Rate: $RATE req/s or pkt/s"
echo ""

if [ "$ATTACK_TYPE" == "app" ]; then
    python3 attack-simulations/crossfire-app-level.py \
        --url "$APP_URL" \
        --duration "$DURATION" \
        --rate "$RATE" \
        --workers "$WORKERS"
elif [ "$ATTACK_TYPE" == "network" ]; then
    echo -e "${YELLOW}⚠ Network-level attack requires root privileges${NC}"
    sudo python3 attack-simulations/crossfire-network-level.py \
        --duration "$DURATION" \
        --rate "$RATE" \
        --threads "$WORKERS"
else
    echo -e "${RED}Error: Invalid attack type. Use 'app' or 'network'${NC}"
    exit 1
fi

# Post-attack observation
echo ""
echo "[6/6] Post-attack observation (30 seconds)..."
echo "Observe recovery in monitoring dashboards..."
sleep 30

# Cleanup
echo ""
echo "Cleaning up port forwards..."
kill $KIALI_PID $GRAFANA_PID $PROMETHEUS_PID 2>/dev/null || true

echo ""
echo "======================================"
echo "Simulation Complete"
echo "======================================"
echo ""
echo "Review the results in your monitoring tools."
echo "Export metrics from Prometheus for further analysis."
echo ""
echo "To run again:"
echo "  Application-level: $0 app <duration> <workers> <rate>"
echo "  Network-level:     $0 network <duration> <threads> <rate>"
